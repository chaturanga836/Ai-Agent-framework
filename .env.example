# =============================================================================
# Deployment / operator only (set by installer or DevOps — not customer-editable)
# =============================================================================

APP_NAME=ELT Agent Service
DEBUG=true
HOST=0.0.0.0
PORT=8100

# Agent service job store (platform Postgres — NOT the customer's database)

# --- Option B: standalone `docker compose up` in this repo ---
# Remote Postgres (match etl-back credentials; DB must be elt_agent):
DATABASE_URL=postgresql://postgres:2324@13.200.160.10:5432/elt_agent
# etl-back reachable from the container (API published on host :8000):
ETL_API_URL=http://host.docker.internal:8000/api/v1

# --- Option B alt: local etl-deployment Postgres on host :5432 ---
# DATABASE_URL=postgresql://elt:changeme@host.docker.internal:5432/elt_agent

# --- Option B + elt-net overlay (etl-deployment already running) ---
# docker compose -f docker-compose.yml -f docker-compose.elt-net.yml up --build
# DATABASE_URL=postgresql://elt:changeme@postgres:5432/elt_agent
# ETL_API_URL=http://api:8000/api/v1

# Do NOT use ranger-db unless that service is on the same Docker network.

# Optional: default service token if jobs do not pass etl_api_token
ETL_API_TOKEN=

# Timeouts
HTTP_TIMEOUT_SECONDS=60
JOB_TIMEOUT_SECONDS=600

# =============================================================================
# Customer settings (OpenAI key, model, customer DB) belong in:
#   Workspace Settings → AI & Agent  (stored in etl-back)
# =============================================================================
# Dev-only fallbacks when running workflows without a workspace token / UI config:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
